# =========================
# HumAIne MinIO-API (wrapper)
# =========================
HUMAINE_API_BASE_URL=https://humaine-minio-api.example.net
HUMAINE_API_USERNAME=CHANGE_ME
HUMAINE_API_PASSWORD=CHANGE_ME

# =========================
# API security
# =========================
API_KEY=CHANGE_ME_STRONG_RANDOM_VALUE

# =========================
# Local dataset paths (read by the API code)
# =========================

# Path to the base dataset CSV inside the container (provisioned once at setup).
# Default if not set: retraining-api/data/base/simulation_security_labels_n-1.csv
# BASE_DATASET_LOCAL_PATH=/app/data/base/simulation_security_labels_n-1.csv

# Path where the appended rows delta CSV is written after downloading from MinIO.
# Default if not set: retraining-api/data/appended/simulation_security_labels_n-1_appended_rows_latest.csv
# APPENDED_ROWS_LOCAL_PATH=/app/data/appended/simulation_security_labels_n-1_appended_rows_latest.csv

# =========================
# NOTE: the following variables are NOT read by the current API code.
# Their values come from RetrainRequest schema defaults or the request body.
# They are kept here for reference only.
# =========================
# RESULTS_BUCKET=smart-energy-results
# LATEST_DATASET_KEY=al_training_dataset/appended_rows/simulation_security_labels_n-1_appended_rows_latest.csv
# MODEL_OUTPUT_PREFIX=models/retraining_runs
