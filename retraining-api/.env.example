# =========================
# HumAIne MinIO-API (wrapper)
# =========================
HUMAINE_API_BASE_URL=https://humaine-minio-api.example.net
HUMAINE_API_USERNAME=CHANGE_ME
HUMAINE_API_PASSWORD=CHANGE_ME

# =========================
# API security
# =========================
API_KEY=CHANGE_ME_STRONG_RANDOM_VALUE

# =========================
# Local dataset paths (read by the API code)
# =========================

# Path to the local base dataset CSV inside the container.
# Mount this via Docker volume: ./data:/app/data
# Default if not set: /app/data/base/simulation_security_labels_n-1.csv
BASE_DATASET_LOCAL_PATH=

# Path where the appended rows delta CSV is written locally.
# Default if not set: /app/data/appended/simulation_security_labels_n-1_appended_rows_latest.csv
APPENDED_ROWS_LOCAL_PATH=
